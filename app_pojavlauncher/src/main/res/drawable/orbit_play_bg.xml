<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><corners android:radius="20dp"/>
            <gradient android:angle="270" android:startColor="#FF36BE66" android:endColor="#FF1E8A40"/>
            <stroke android:width="1dp" android:color="#40FFFFFF"/></shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><corners android:radius="20dp"/>
            <solid android:color="#FF2A3A30"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><corners android:radius="20dp"/>
            <gradient android:angle="270" android:startColor="#FF4AD879" android:centerColor="#FF2CAE54" android:endColor="#FF25994A"/>
            <stroke android:width="1dp" android:color="#59FFFFFF"/></shape>
    </item>
</selector>
